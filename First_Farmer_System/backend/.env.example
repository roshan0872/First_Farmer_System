# Environment Configuration for First Farmer Agriculture System
PROJECT_NAME="First Farmer Agriculture System"
API_V1_STR="/api"
SECRET_KEY="replace_this_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary MySQL configuration (Recommended in production or Docker):
# DATABASE_URL="mysql+pymysql://firstfarmer_user:securepassword123@localhost:3306/first_farmer_db"
# Local fallback (Automatic SQLite when MySQL is not running locally):
DATABASE_URL="sqlite:///./first_farmer.db"

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Genuine Weather API Configuration (e.g. OpenWeatherMap)
# If left empty, system gracefully provides clear fallback educational guidance and informs user
OPENWEATHER_API_KEY=""

# Optional AI API Provider for Agriculture Chatbot (e.g. Gemini, OpenAI)
# If left empty, system uses robust verified agricultural knowledge base retrieval matching
AI_API_KEY=""
AI_PROVIDER=""
